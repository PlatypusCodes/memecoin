rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "detlaffcameron@gmail.com";
    }

    // ---------- users/{uid} ----------
    match /users/{userId} {
      // Leaderboard needs to read every user's balance/holdings, so any
      // authenticated user can read the users collection. Writes are still
      // locked down below.
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.username is string
        && request.resource.data.username.size() > 0
        && request.resource.data.username.size() <= 18
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && request.resource.data.holdings is number
        && request.resource.data.holdings >= 0;

      // Normal users can update their own allowed fields.
      // Admin can update any field on any user (for balance adjustments etc).
      allow update: if request.auth != null && (
        (request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['balance', 'holdings', 'username', 'avatarUrl',
                         'costBasis', 'realizedPnl', 'referredBy', 'referralBonuses',
                         'pinnedItem', 'quickBuys', 'quickSells',
                         'buyMarkerOpacity', 'sellMarkerOpacity',
                         'shortPosition', 'shortRealizedPnl'])
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0
          && request.resource.data.holdings is number
          && request.resource.data.holdings >= 0
          && request.resource.data.get('buyMarkerOpacity', 1) is number
          && request.resource.data.get('buyMarkerOpacity', 1) >= 0
          && request.resource.data.get('buyMarkerOpacity', 1) <= 1
          && request.resource.data.get('sellMarkerOpacity', 1) is number
          && request.resource.data.get('sellMarkerOpacity', 1) >= 0
          && request.resource.data.get('sellMarkerOpacity', 1) <= 1
          && (request.resource.data.get('shortPosition', null) == null
              || (request.resource.data.shortPosition.size is number
                  && request.resource.data.shortPosition.size >= 0
                  && request.resource.data.shortPosition.entryPrice is number
                  && request.resource.data.shortPosition.entryPrice > 0)))
        || isAdmin()
      );

      allow delete: if false;
    }

    // ---------- market/state ----------
    match /market/{docId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.price is number
        && request.resource.data.price > 0;

      // Allow all authenticated users to update market state.
      // The full field set has grown (historyAnchor, boostModeEndTime,
      // dumpModeEndTime, _open24hDay) so we use a loose field check here
      // and rely on the leader-election logic in the client to prevent
      // conflicting writes rather than enumerating every field in rules.
      allow update: if request.auth != null
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.price < 1000000000000000;

      allow delete: if false;
    }

    // ---------- ticks/{tickId} ----------
    match /ticks/{tickId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.ts is number;
      allow delete: if false;
    }

    // ---------- trades/{tradeId} ----------
    match /trades/{tradeId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['buy', 'sell', 'short', 'cover']
        && request.resource.data.usdAmount is number
        && request.resource.data.usdAmount >= 0
        && request.resource.data.price is number
        && request.resource.data.price > 0
        && request.resource.data.username is string;

      allow update, delete: if false;
    }
  }
}
